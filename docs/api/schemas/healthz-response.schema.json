{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphx.local/schemas/healthz-response",
  "title": "Health Check Response",
  "description": "Response from /healthz endpoint indicating server health status",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["alive", "ready", "degraded"],
      "description": "Server health status"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of response"
    },
    "version": {
      "type": "string",
      "description": "API version (e.g., '1.0.0')"
    }
  },
  "required": ["status"],
  "additionalProperties": false
}
