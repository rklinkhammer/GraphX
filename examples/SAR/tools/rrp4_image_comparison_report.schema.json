{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graphx.sar.image_comparison_report.v1",
  "title": "GraphX SAR Image Comparison Report",
  "type": "object",
  "required": [
    "schema_version",
    "comparator",
    "scenario_id",
    "thresholds",
    "verdict",
    "passed",
    "graphx",
    "reference",
    "metrics",
    "checks",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "graphx.sar.image_comparison_report.v1"
    },
    "comparator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "scenario_id": {"type": "string"},
    "thresholds": {
      "type": "object",
      "required": [
        "mode",
        "peak_window_radius_pixels",
        "rms_max",
        "relative_l2_max",
        "max_abs_error_max",
        "peak_coordinate_delta_pixels_max",
        "pslr_db_min",
        "islr_db_min"
      ],
      "properties": {
        "mode": {"type": "string"},
        "peak_window_radius_pixels": {"type": "integer"},
        "rms_max": {"type": "number"},
        "relative_l2_max": {"type": "number"},
        "max_abs_error_max": {"type": "number"},
        "peak_coordinate_delta_pixels_max": {"type": "number"},
        "pslr_db_min": {"type": ["number", "null"]},
        "islr_db_min": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "verdict": {"enum": ["pass", "fail"]},
    "passed": {"type": "boolean"},
    "graphx": {
      "type": "object",
      "required": [
        "source_tool",
        "provenance_class",
        "scenario_id",
        "format",
        "layout",
        "artifact_kind",
        "dtype",
        "width",
        "height",
        "byte_count",
        "raw_path",
        "image_hash",
        "pixel_count"
      ],
      "properties": {
        "source_tool": {"type": "string"},
        "provenance_class": {"type": "string"},
        "scenario_id": {"type": "string"},
        "format": {"type": "string"},
        "layout": {"type": "string"},
        "artifact_kind": {"type": "string"},
        "dtype": {"type": "string"},
        "width": {"type": "integer"},
        "height": {"type": "integer"},
        "byte_count": {"type": "integer"},
        "raw_path": {"type": "string"},
        "image_hash": {"type": "string"},
        "pixel_count": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": [
        "source_tool",
        "provenance_class",
        "scenario_id",
        "format",
        "layout",
        "artifact_kind",
        "dtype",
        "width",
        "height",
        "byte_count",
        "raw_path",
        "image_hash",
        "pixel_count"
      ],
      "properties": {
        "source_tool": {"type": "string"},
        "provenance_class": {"type": "string"},
        "scenario_id": {"type": "string"},
        "format": {"type": "string"},
        "layout": {"type": "string"},
        "artifact_kind": {"type": "string"},
        "dtype": {"type": "string"},
        "width": {"type": "integer"},
        "height": {"type": "integer"},
        "byte_count": {"type": "integer"},
        "raw_path": {"type": "string"},
        "image_hash": {"type": "string"},
        "pixel_count": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "l_inf",
        "rms",
        "relative_l2",
        "max_abs_error",
        "peak_coordinate_delta_x_pixels",
        "peak_coordinate_delta_y_pixels",
        "peak_coordinate_delta_pixels",
        "pslr_db",
        "islr_db"
      ],
      "properties": {
        "l_inf": {"type": ["number", "null"]},
        "rms": {"type": ["number", "null"]},
        "relative_l2": {"type": ["number", "null"]},
        "max_abs_error": {"type": ["number", "null"]},
        "peak_coordinate_delta_x_pixels": {"type": ["number", "null"]},
        "peak_coordinate_delta_y_pixels": {"type": ["number", "null"]},
        "peak_coordinate_delta_pixels": {"type": ["number", "null"]},
        "pslr_db": {"type": ["number", "null"]},
        "islr_db": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": {"type": "string"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "reasons": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}