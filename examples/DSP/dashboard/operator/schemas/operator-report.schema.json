    "qualification":{"type":"object","additionalProperties":false,"required":["dashboard_scope","input_evidence","hwil_conducted_ota_evidence","receiver_truth_isolation","browser_automation","security_local_profile","operator_workflow","production_rf_qualification"],"properties":{"dashboard_scope":{"const":"FHSS-specific"},"input_evidence":{"const":"synthetic IQ only"},"hwil_conducted_ota_evidence":{"const":"unavailable and deferred"},"receiver_truth_isolation":{"const":"PASS"},"browser_automation":{"const":"PASS"},"security_local_profile":{"const":"PASS"},"operator_workflow":{"const":"PASS"},"production_rf_qualification":{"const":"NOT QUALIFIED"}}}
  }
}
