{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://graphx.local/schemas/phase8-lane-evidence.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema","lane","profile","command","status","junit_path","junit_sha256","counts"],
  "properties":{
    "schema":{"const":"graphx.fhss.dashboard.phase8_lane_evidence.v1"},
    "lane":{"enum":["focused","full","sanitizer","concurrency"]},
    "profile":{"enum":["c++26-focused","c++26-full-regression","asan-ubsan","tsan"]},
    "command":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "status":{"enum":["PASS","FAIL"]},
    "junit_path":{"type":"string","minLength":1},
    "junit_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "counts":{"type":"object","additionalProperties":false,"required":["passed","total","failed","skipped"],"properties":{"passed":{"type":"integer","minimum":0},"total":{"type":"integer","minimum":1},"failed":{"type":"integer","minimum":0},"skipped":{"type":"integer","minimum":0}}}
  }
}
