{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://graphx.local/schemas/phase8-accessibility-engine.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema","tree","execution_id","executed_at","engine","engine_version","browser","dashboard_url","result","violations","incomplete","report_path","report_sha256","provenance"],
  "properties":{
    "schema":{"const":"graphx.fhss.dashboard.phase8_accessibility_engine.v1"},
    "tree":{"enum":["source","installed"]},
    "execution_id":{"type":"string","pattern":"^axe-(source|installed)-[0-9a-f-]{36}$"},
    "executed_at":{"type":"string","format":"date-time"},
    "engine":{"const":"axe-core"},"engine_version":{"const":"4.12.1"},
    "browser":{"type":"string","pattern":"^Firefox/"},
    "dashboard_url":{"type":"string","pattern":"^http://127\\.0\\.0\\.1:[0-9]+$"},
    "result":{"enum":["PASS","FAIL"]},
    "violations":{"$ref":"#/$defs/findings"},
    "incomplete":{"$ref":"#/$defs/findings"},
    "report_path":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+$"},
    "report_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "provenance":{"type":"object","additionalProperties":false,
      "required":["package_name","package_version","tarball_url","registry_integrity","package_path","package_sha256","package_sha512","axe_min_path","axe_min_sha256","license_path","license_sha256","third_party_license_path","third_party_license_sha256"],
      "properties":{
        "package_name":{"const":"axe-core"},
        "package_version":{"const":"4.12.1"},
        "tarball_url":{"const":"https://registry.npmjs.org/axe-core/-/axe-core-4.12.1.tgz"},
        "registry_integrity":{"const":"sha512-s7iGf5GaVMxEG0ENN9x+xTr7GFZCb1ZP/1uATUpCEK2X78nDB3RwbtFCo9pGAf9ru+VwoQ464DkaLEeRM08wJA=="},
        "package_path":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+$"},
        "package_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "package_sha512":{"type":"string","pattern":"^[0-9a-f]{128}$"},
        "axe_min_path":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+$"},
        "axe_min_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "license_path":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+$"},
        "license_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "third_party_license_path":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+$"},
        "third_party_license_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }}
  },
  "$defs":{
    "counts":{"type":"object","additionalProperties":false,"required":["critical","serious","moderate","minor"],"properties":{"critical":{"type":"integer","minimum":0},"serious":{"type":"integer","minimum":0},"moderate":{"type":"integer","minimum":0},"minor":{"type":"integer","minimum":0}}},
    "finding":{"type":"object","additionalProperties":false,"required":["rule_id","impact","node_count","targets"],"properties":{"rule_id":{"type":"string","minLength":1},"impact":{"enum":["critical","serious","moderate","minor"]},"node_count":{"type":"integer","minimum":1},"targets":{"type":"array","minItems":1,"items":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}}},
    "findings":{"type":"object","additionalProperties":false,"required":["counts","items"],"properties":{"counts":{"$ref":"#/$defs/counts"},"items":{"type":"array","items":{"$ref":"#/$defs/finding"}}}}
  }
}
