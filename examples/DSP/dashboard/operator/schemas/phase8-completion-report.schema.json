{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://graphx.local/schemas/phase8-completion-report.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema","dashboard_scope","input_evidence","hwil_conducted_ota_evidence","receiver_truth_isolation","focused_tests","full_regressions","browser_accessibility","accessibility_engine","security_local_profile","operator_workflow","sanitizer","concurrency","soak","fuzz_smoke","production_rf_qualification","evidence_hashes","manual_wcag_tester","manual_wcag_executed_at","signed_off_by","signed_off_at"],
  "properties":{
    "schema":{"const":"graphx.fhss.dashboard.phase8_completion_report.v1"},
    "dashboard_scope":{"const":"FHSS-specific"},"input_evidence":{"const":"synthetic IQ only"},
    "hwil_conducted_ota_evidence":{"const":"unavailable and deferred"},
    "receiver_truth_isolation":{"const":"PASS"},
    "focused_tests":{"$ref":"#/$defs/counts"},"full_regressions":{"$ref":"#/$defs/counts"},
    "browser_accessibility":{"const":"PASS"},
    "accessibility_engine":{"type":"object","additionalProperties":false,"required":["source","installed"],"properties":{"source":{"$ref":"#/$defs/axeSummary"},"installed":{"$ref":"#/$defs/axeSummary"}}},
    "security_local_profile":{"const":"PASS"},
    "operator_workflow":{"const":"PASS"},"sanitizer":{"const":"PASS"},
    "concurrency":{"const":"PASS"},"soak":{"const":"PASS"},"fuzz_smoke":{"const":"PASS"},
    "production_rf_qualification":{"const":"NOT QUALIFIED"},
    "evidence_hashes":{"type":"object","minProperties":20,"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "manual_wcag_tester":{"type":"string","minLength":2},
    "manual_wcag_executed_at":{"type":"string","format":"date-time"},
    "signed_off_by":{"type":"string","minLength":1},"signed_off_at":{"type":"string","format":"date-time"}
  },
  "$defs":{
    "counts":{"type":"object","additionalProperties":false,"required":["passed","total","failed","skipped"],"properties":{"passed":{"type":"integer","minimum":1},"total":{"type":"integer","minimum":1},"failed":{"const":0},"skipped":{"const":0}}},
    "axeCounts":{"type":"object","additionalProperties":false,"required":["critical","serious","moderate","minor"],"properties":{"critical":{"type":"integer","minimum":0},"serious":{"type":"integer","minimum":0},"moderate":{"type":"integer","minimum":0},"minor":{"type":"integer","minimum":0}}},
    "axeFinding":{"type":"object","additionalProperties":false,"required":["rule_id","impact","node_count","targets"],"properties":{"rule_id":{"type":"string","minLength":1},"impact":{"enum":["critical","serious","moderate","minor"]},"node_count":{"type":"integer","minimum":1},"targets":{"type":"array","minItems":1,"items":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}}},
    "axeFindings":{"type":"object","additionalProperties":false,"required":["counts","items"],"properties":{"counts":{"$ref":"#/$defs/axeCounts"},"items":{"type":"array","items":{"$ref":"#/$defs/axeFinding"}}}},
    "axeSummary":{"type":"object","additionalProperties":false,"required":["violations","incomplete"],"properties":{"violations":{"$ref":"#/$defs/axeFindings"},"incomplete":{"$ref":"#/$defs/axeFindings"}}}
  }
}
