  "components":{"parameters":{"IfMatch":{"name":"If-Match","in":"header","required":true,"schema":{"type":"string","pattern":"^\\\"graphx-config-[0-9]+\\\"$"}}},"schemas":{"Problem":{"$ref":"schemas/problem.schema.json"},"JsonPatch":{"type":"array","items":{"oneOf":[{"type":"object","required":["op","path","value"],"properties":{"op":{"enum":["add","replace","test"]},"path":{"type":"string"},"value":{}},"additionalProperties":false},{"type":"object","required":["op","path"],"properties":{"op":{"const":"remove"},"path":{"type":"string"}},"additionalProperties":false},{"type":"object","required":["op","path","from"],"properties":{"op":{"enum":["move","copy"]},"path":{"type":"string"},"from":{"type":"string"}},"additionalProperties":false}]}}},"responses":{
    "Health":{"description":"Live","content":{"application/json":{"schema":{"$ref":"schemas/health.schema.json"}}}},
    "Readiness":{"description":"Ready","content":{"application/json":{"schema":{"$ref":"schemas/readiness.schema.json"}}}},
    "Version":{"description":"Version","content":{"application/json":{"schema":{"$ref":"schemas/version.schema.json"}}}},
    "Graph":{"description":"Effective graph","content":{"application/json":{"schema":{"$ref":"schemas/graph.schema.json"}}}},
    "Config":{"description":"Effective configuration","content":{"application/json":{"schema":{"$ref":"schemas/config.schema.json"}}}},
    "Metrics":{"description":"Receiver metrics","content":{"application/json":{"schema":{"$ref":"schemas/metrics.schema.json"}}}},
    "Diagnostics":{"description":"Receiver diagnostics atomically scoped to active generation, run epoch, configuration revision, and ETag","content":{"application/json":{"schema":{"$ref":"schemas/diagnostics.schema.json"}}}},
    "Provenance":{"description":"Architecture derivation provenance","headers":{"ETag":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"schemas/configuration-provenance.schema.json"}}}},
    "ReceiverGraph":{"description":"Truth-free binary-IQ receiver graph","headers":{"ETag":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"schemas/receiver-graph.schema.json"}}}},
    "ConfigValidation":{"description":"Validation-only result","headers":{"ETag":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"schemas/config-validation.schema.json"}}}},
    "ConfigResult":{"description":"Applied configuration result","headers":{"ETag":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"schemas/config-result.schema.json"}}}},
    "EdgeMetrics":{"description":"Edge metrics","content":{"application/json":{"schema":{"$ref":"schemas/edge-metrics.schema.json"}}}},
    "Scenario":{"description":"Authoritative synthetic scenario","content":{"application/json":{"schema":{"$ref":"schemas/scenario.schema.json"}}}},
    "DerivedPaths":{"description":"Derived paths","content":{"application/json":{"schema":{"$ref":"schemas/derived-paths.schema.json"}}}},
    "Value":{"description":"Configuration value","content":{"application/json":{"schema":{"$ref":"schemas/value.schema.json"}}}},
    "Node":{"description":"Node","content":{"application/json":{"schema":{"$ref":"schemas/node.schema.json"}}}},
    "NodeParameters":{"description":"Node parameters","content":{"application/json":{"schema":{"$ref":"schemas/node-parameters.schema.json"}}}},
    "Visualization":{"description":"Synthetic expected and receiver-derived visualization","content":{"application/json":{"schema":{"$ref":"schemas/visualization.schema.json"}}}},
    "FHSSExpectedTruth":{"description":"Evaluator-side synthetic expected truth; never receiver input","content":{"application/json":{"schema":{"$ref":"schemas/fhss-expected-truth.schema.json"}}}},
    "FHSSReceiverObservation":{"description":"Receiver-produced observation with explicit availability","content":{"application/json":{"schema":{"$ref":"schemas/fhss-receiver-observation.schema.json"}}}},
    "FHSSComparison":{"description":"Evaluator-only deterministic expected/observed comparison","content":{"application/json":{"schema":{"$ref":"schemas/fhss-comparison-result.schema.json"}}}},
    "FHSSSpectrum":{"description":"Bounded spectrum calculated from captured receiver channel samples","content":{"application/json":{"schema":{"$ref":"schemas/fhss-receiver-spectrum.schema.json"}}}},
    "FHSSObservationProvenance":{"description":"Field-level receiver observation provenance","content":{"application/json":{"schema":{"$ref":"schemas/fhss-observation-provenance.schema.json"}}}},
    "FHSSObservationHistory":{"description":"Bounded active-run observation history","content":{"application/json":{"schema":{"$ref":"schemas/fhss-observation-history.schema.json"}}}},
