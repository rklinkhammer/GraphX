{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graphx:dashboard:receiver-graph:v1",
  "$defs": {
    "receiverValue": {
      "not": {"anyOf": [
        {"type":"object","required":["messages"]}, {"type":"object","required":["truth_from_fixture"]},
        {"type":"object","required":["truth_path"]}, {"type":"object","required":["truth_file"]},
        {"type":"object","required":["generator_metadata"]},
        {"type":"object","required":["transmitted_active_frequency_indices"]},
        {"type":"object","required":["transmitted_pulse_frequency_indices"]},
        {"type":"object","required":["active_frequency_indices"]}
      ]},
      "additionalProperties": {"$ref":"urn:graphx:dashboard:receiver-graph:v1#/$defs/receiverValue"},
      "items": {"$ref":"urn:graphx:dashboard:receiver-graph:v1#/$defs/receiverValue"}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "config_revision", "etag", "graph"],
  "properties": {
    "schema": {"const": "graphx.dashboard.receiver_graph.v1"},
    "config_revision": {"type": "integer", "minimum": 0},
    "etag": {"type": "string"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "execution_backend", "backend_fallback_policy", "fhss_graph_role", "canonical_fhss_graph", "reference_only", "resolver_diagnostics", "nodes", "edges"],
      "properties": {
        "name":{"type":"string"},"description":{"type":"string"},"execution_backend":{"type":"string"},
        "backend_fallback_policy":{"type":"string"},"fhss_graph_role":{"type":"string"},
        "canonical_fhss_graph":{"type":"boolean"},"reference_only":{"type":"boolean"},
        "resolver_diagnostics":{"type":"boolean"},
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "groups": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "members"],
                "properties": {
                  "id": {"type": "string", "minLength": 1, "maxLength": 128},
                  "label": {"type": "string", "minLength": 1, "maxLength": 256},
                  "members": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
                  "layout": {"enum": ["grid", "row", "column"]},
                  "collapsed_by_default": {"type": "boolean"}
                }
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "contains":{"type":"object","required":["id","type","node_config"],"properties":{"id":{"const":"source"},"type":{"const":"FHSSBinaryIqFileSourceNode"},"node_config":{"$ref":"urn:graphx:dashboard:receiver-graph:v1#/$defs/receiverValue","type":"object","required":["file_path","sample_format","sample_rate_hz"],"properties":{"file_path":{"type":"string"},"sample_format":{"enum":["cf32_le","cf64_le"]},"sample_rate_hz":{"type":"number","minimum":1}}}}},
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "node_config": {"$ref":"urn:graphx:dashboard:receiver-graph:v1#/$defs/receiverValue"}
            }
          }
        },
        "edges": {"type": "array", "minItems": 1, "items":{"type":"object","required":["source_node_id","source_port","target_node_id","target_port"]}}
      }
    }
  }
}
