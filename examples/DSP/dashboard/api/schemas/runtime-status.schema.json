{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:graphx:dashboard:runtime-status:v1",
  "type":"object",
  "required":["schema","lifecycle_state","ready","rebuild_allowed","rebuild_blocked","active_generation","active_run_epoch","rebuild_attempts","successful_rebuilds","active_config_revision","active_config_etag","config_revision","etag","rebuild_required","configuration_stale","stop_requested","started_at","terminal_at","terminal_result","last_error"],
  "additionalProperties":false,
  "$defs":{"safe":{"type":"integer","minimum":0,"maximum":9007199254740991}},
  "properties":{
    "schema":{"const":"graphx.dashboard.runtime_status.v1"},
    "lifecycle_state":{"enum":["initializing","not_built","stopped","starting","running","completed","failed","rebuilding","cleanup_failed","shutting_down","dead"]},
    "ready":{"type":"boolean"},"rebuild_allowed":{"type":"boolean"},"rebuild_blocked":{"type":"boolean"},
    "active_generation":{"$ref":"#/$defs/safe"},"active_run_epoch":{"$ref":"#/$defs/safe"},
    "rebuild_attempts":{"$ref":"#/$defs/safe"},"successful_rebuilds":{"$ref":"#/$defs/safe"},
    "active_config_revision":{"$ref":"#/$defs/safe"},"active_config_etag":{"type":"string","maxLength":256},
    "config_revision":{"$ref":"#/$defs/safe"},"etag":{"type":"string","maxLength":256},
    "rebuild_required":{"type":"boolean"},"configuration_stale":{"type":"boolean"},"stop_requested":{"type":"boolean"},
    "started_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},
    "terminal_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},
    "terminal_result":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["generation","code","message"],"properties":{"generation":{"type":"integer","minimum":1,"maximum":9007199254740991},"code":{"enum":["execution_completed","execution_failed","execution_cancelled"]},"message":{"type":"string","maxLength":1024}}}]},
    "last_error":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"type":"string","maxLength":128},"message":{"type":"string","maxLength":1024}}}]}
  }
}
