{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:graphx:dashboard:fhss-job:v1","type":"object","additionalProperties":false,
  "required":["schema","controller_epoch","job_id","request_id","idempotency_key_digest","scenario_correlation_id","job_sequence","operation","state","message_cursor","message_count","sample_format","config_revision","config_etag","graph_generation","run_epoch","created_at","started_at","terminal_at","terminal","work","artifacts","graph_lifecycle","receiver_message_result","receiver_observation","comparison"],
  "properties":{
    "schema":{"const":"graphx.dashboard.fhss_job.v1"},"controller_epoch":{"type":"integer","minimum":1},
    "job_id":{"type":"string","pattern":"^j-[0-9a-f]{24}$"},"request_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9._:-]+$"},
    "idempotency_key_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"scenario_correlation_id":{"type":"string","pattern":"^s-[0-9a-f]{24}$"},
    "job_sequence":{"type":"integer","minimum":1},"operation":{"enum":["step","continue"]},
    "state":{"enum":["queued","generating","generated","replay_pending","running","cancelling","completed","cancelled","timed_out","failed","abandoned_on_restart"]},
    "message_cursor":{"type":"integer","minimum":0},"message_count":{"type":"integer","minimum":1,"maximum":4},"sample_format":{"enum":["cf32_le","cf64_le"]},
    "config_revision":{"type":"integer","minimum":0},"config_etag":{"type":"string"},"graph_generation":{"type":"integer","minimum":0},"run_epoch":{"type":"integer","minimum":0},
    "created_at":{"type":"string","format":"date-time"},"started_at":{"type":["string","null"],"format":"date-time"},"terminal_at":{"type":["string","null"],"format":"date-time"},
    "terminal":{"type":"object","additionalProperties":false,"required":["code","detail"],"properties":{"code":{"type":["string","null"]},"detail":{"type":["string","null"]}}},
    "work":{"type":"object","additionalProperties":false,"required":["generator_invoked","receiver_replay_invoked"],"properties":{"generator_invoked":{"type":"boolean"},"receiver_replay_invoked":{"type":"boolean"}}},
    "artifacts":{"type":"object","maxProperties":5,"additionalProperties":{"$ref":"urn:graphx:dashboard:fhss-job:v1#/$defs/artifact"}},
    "graph_lifecycle":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["state","terminal_code","terminal_detail"],"properties":{"state":{"enum":["completed","failed","stopped"]},"terminal_code":{"type":"string","maxLength":64},"terminal_detail":{"type":"string","maxLength":1024}}}]},
    "receiver_message_result":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["availability"],"properties":{"availability":{"type":"object"},"status":{"type":"string","maxLength":1024},"accepted":{"type":"boolean"},"decoded_pulse_count":{"type":"integer","minimum":0,"maximum":512}}}]},
    "receiver_observation":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["observation_id","observation_sha256"],"properties":{"observation_id":{"type":"string","pattern":"^observation-g[0-9]+-r[0-9]+$"},"observation_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}]},
    "comparison":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["evaluation_state","comparison_sha256","availability"],"properties":{"evaluation_state":{"enum":["evaluated","indeterminate"]},"comparison_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"availability":{"type":"object"}}}]},
    "idempotency":{"type":"object","additionalProperties":false,"required":["reused","key_digest"],"properties":{"reused":{"type":"boolean"},"key_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
  },
  "$defs":{"artifact":{"type":"object","additionalProperties":false,"required":["relative_path","sha256"],"properties":{"relative_path":{"type":"string","maxLength":64,"pattern":"^[A-Za-z0-9._-]+$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"bytes":{"type":"integer","minimum":0,"maximum":67108864}}}}
}
