        {"if":{"properties":{"availability":{"const":"unavailable"}}},"then":{"properties":{"reason":{"type":"string","minLength":1},"clock":{"type":"null"},"start_event":{"type":"null"},"end_event":{"type":"null"},"count":{"type":"null"},"cumulative_total":{"type":"null"}}}}
