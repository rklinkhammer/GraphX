        "edge_index":{"$ref":"#/$defs/safeInteger"},
        "source_node_index":{"$ref":"#/$defs/safeInteger"},
        "source_node_name":{"type":"string","maxLength":256},
        "source_port_index":{"$ref":"#/$defs/safeInteger"},
