    "collectionInterval": {"type":"object","required":["state","reason","clock","duration_ms"],"additionalProperties":false,"properties":{"state":{"enum":["available","unavailable"]},"reason":{"type":["string","null"],"maxLength":512},"clock":{"const":"steady_clock"},"duration_ms":{"anyOf":[{"type":"integer","minimum":1,"maximum":9007199254740991},{"type":"null"}]}},"allOf":[{"if":{"properties":{"state":{"const":"available"}}},"then":{"properties":{"reason":{"type":"null"},"duration_ms":{"type":"integer","minimum":1,"maximum":9007199254740991}}}},{"if":{"properties":{"state":{"const":"unavailable"}}},"then":{"properties":{"reason":{"type":"string","minLength":1},"duration_ms":{"type":"null"}}}}]},
    "identityAvailability": {"type":"object","required":["state","reason"],"additionalProperties":false,"properties":{"state":{"enum":["available","unavailable"]},"reason":{"type":["string","null"],"maxLength":512},"canonical_node_count":{"$ref":"#/$defs/safeInteger"},"canonical_edge_count":{"$ref":"#/$defs/safeInteger"}}},
