        {"properties":{"name":{"const":"current_queue_depth"},"field":{"const":"/edges/*/current_queue_depth"},"scope":{"const":"edge"},"kind":{"const":"gauge"},"unit":{"const":"message"},"monotonic":{"const":false},"reset":{"const":"sample_replaced"},"aggregation":{"const":"no cross-sample aggregation"}}},
