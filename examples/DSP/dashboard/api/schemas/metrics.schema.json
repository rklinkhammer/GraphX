        {"properties":{"name":{"const":"messages_dequeued"},"field":{"const":"/edges/*/messages_dequeued"},"scope":{"const":"edge"},"kind":{"const":"counter"},"unit":{"const":"message"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"direct atomic edge counter; never re-summed by dashboard"}}},
