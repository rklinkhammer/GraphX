        {"properties":{"name":{"const":"started"},"field":{"const":"/edges/*/started"},"scope":{"const":"edge"},"kind":{"const":"state"},"unit":{"const":"boolean"},"monotonic":{"const":false},"reset":{"const":"sample_replaced"},"aggregation":{"const":"one state per canonical record"}}},
