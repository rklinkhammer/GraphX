        {"if":{"properties":{"availability":{"const":"unavailable"}}},"then":{"properties":{"unavailable_reason":{"type":"string","minLength":1},"messages_enqueued":{"type":"null"},"messages_dequeued":{"type":"null"},"messages_rejected":{"type":"null"},"backpressure_events":{"type":"null"},"peak_queue_depth":{"type":"null"},"activity_state":{"const":"unavailable"}}}}
