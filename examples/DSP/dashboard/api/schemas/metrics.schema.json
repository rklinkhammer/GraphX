        {"properties":{"name":{"const":"node_processing_duration"},"field":{"const":"/edges/*/node_processing_duration"},"scope":{"const":"edge"},"kind":{"const":"distribution"},"unit":{"const":"nanosecond"},"monotonic":{"const":false},"reset":{"const":"not_collected"},"aggregation":{"const":"explicitly unavailable; node service intervals are not collected here"}}},
        {"properties":{"name":{"const":"end_to_end_duration"},"field":{"const":"/edges/*/end_to_end_duration"},"scope":{"const":"edge"},"kind":{"const":"distribution"},"unit":{"const":"nanosecond"},"monotonic":{"const":false},"reset":{"const":"not_collected"},"aggregation":{"const":"explicitly unavailable; messages are not end-to-end correlated"}}},
