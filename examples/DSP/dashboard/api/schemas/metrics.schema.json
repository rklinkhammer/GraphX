        {"properties":{"name":{"const":"total_items_rejected"},"field":{"const":"/graph/total_items_rejected"},"scope":{"const":"graph"},"kind":{"const":"counter"},"unit":{"const":"item"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"runtime manager aggregate loaded atomically; never re-summed by dashboard"}}},
        {"properties":{"name":{"const":"total_messages_processed"},"field":{"const":"/graph/total_messages_processed"},"scope":{"const":"graph"},"kind":{"const":"counter"},"unit":{"const":"message"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"runtime manager aggregate loaded atomically; never re-summed by dashboard"}}},
        {"properties":{"name":{"const":"graph_total_enqueued"},"field":{"const":"/graph/graph_total_enqueued"},"scope":{"const":"graph"},"kind":{"const":"counter"},"unit":{"const":"message"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"runtime manager aggregate loaded atomically; never re-summed by dashboard"}}},
        {"properties":{"name":{"const":"graph_total_dequeued"},"field":{"const":"/graph/graph_total_dequeued"},"scope":{"const":"graph"},"kind":{"const":"counter"},"unit":{"const":"message"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"runtime manager aggregate loaded atomically; never re-summed by dashboard"}}},
        {"properties":{"name":{"const":"backpressure_events"},"field":{"const":"/graph/backpressure_events"},"scope":{"const":"graph"},"kind":{"const":"counter"},"unit":{"const":"event"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"runtime manager aggregate loaded atomically; never re-summed by dashboard"}}},
        {"properties":{"name":{"const":"peak_queue_depth"},"field":{"const":"/graph/peak_queue_depth"},"scope":{"const":"graph"},"kind":{"const":"gauge"},"unit":{"const":"message"},"monotonic":{"const":false},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"maximum retained by the active runtime manager"}}},
        {"properties":{"name":{"const":"peak_active_threads"},"field":{"const":"/graph/peak_active_threads"},"scope":{"const":"graph"},"kind":{"const":"gauge"},"unit":{"const":"thread"},"monotonic":{"const":false},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"maximum retained by the active runtime manager"}}},
        {"properties":{"name":{"const":"inbound_messages"},"field":{"const":"/nodes/*/inbound_messages"},"scope":{"const":"node"},"kind":{"const":"counter"},"unit":{"const":"message"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"checked sum of incident canonical edge counters in one collection"}}},
        {"properties":{"name":{"const":"outbound_messages"},"field":{"const":"/nodes/*/outbound_messages"},"scope":{"const":"node"},"kind":{"const":"counter"},"unit":{"const":"message"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"checked sum of incident canonical edge counters in one collection"}}},
        {"properties":{"name":{"const":"rejected_messages"},"field":{"const":"/nodes/*/rejected_messages"},"scope":{"const":"node"},"kind":{"const":"counter"},"unit":{"const":"message"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"checked sum of incident canonical edge counters in one collection"}}},
        {"properties":{"name":{"const":"backpressure_events"},"field":{"const":"/nodes/*/backpressure_events"},"scope":{"const":"node"},"kind":{"const":"counter"},"unit":{"const":"event"},"monotonic":{"const":true},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"checked sum of incident canonical edge counters in one collection"}}},
        {"properties":{"name":{"const":"peak_queue_depth"},"field":{"const":"/nodes/*/peak_queue_depth"},"scope":{"const":"node"},"kind":{"const":"gauge"},"unit":{"const":"message"},"monotonic":{"const":false},"reset":{"const":"new_runtime_manager"},"aggregation":{"const":"maximum retained by the active runtime manager"}}},
