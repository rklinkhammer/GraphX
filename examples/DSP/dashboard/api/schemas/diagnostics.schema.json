{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:graphx:dashboard:diagnostics:v1",
  "type":"object",
  "required":["schema","active_generation","active_run_epoch","active_config_revision","active_config_etag","capture_id","sampled_at_monotonic_ms","identity_availability","nodes"],
  "additionalProperties":false,
  "properties":{
    "schema":{"const":"graphx.dashboard.diagnostics.v1"},
    "active_generation":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "active_run_epoch":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "active_config_revision":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "active_config_etag":{"type":"string","maxLength":256},
    "capture_id":{"type":"string","minLength":1,"maxLength":128},
    "sampled_at_monotonic_ms":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "identity_availability":{"type":"object","required":["state","reason"],"additionalProperties":false,"properties":{"state":{"enum":["available","unavailable"]},"reason":{"type":["string","null"],"maxLength":512}}},
    "nodes":{
      "type":"array","maxItems":256,
      "items":{
        "type":"object",
        "required":["node_id","availability","unavailable_reason","node_index","name","type","diagnostics"],
        "additionalProperties":false,
        "properties":{
          "node_id":{"type":"string","minLength":1,"maxLength":128},
          "availability":{"enum":["available","unavailable"]},
          "unavailable_reason":{"type":["string","null"],"maxLength":512},
          "node_index":{"type":"integer","minimum":0,"maximum":255},
          "name":{"type":"string","maxLength":256},
          "type":{"type":"string","minLength":1,"maxLength":256},
          "diagnostics":{"type":["object","null"]}
        },
        "allOf":[
          {"if":{"properties":{"availability":{"const":"available"}}},"then":{"properties":{"unavailable_reason":{"type":"null"},"diagnostics":{"type":"object"}}}},
          {"if":{"properties":{"availability":{"const":"unavailable"}}},"then":{"properties":{"unavailable_reason":{"type":"string","minLength":1},"diagnostics":{"type":"null"}}}}
        ]
      }
    }
  }
}
