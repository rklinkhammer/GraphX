{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graphx:dashboard:event:v1",
  "type": "object",
  "required": ["schema", "api_version", "publisher_epoch", "sequence", "event_type", "timestamp", "generation", "run_epoch", "config_revision", "config_etag", "controller_epoch", "job_id", "correlation_id", "semantic_class", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "graphx.dashboard.event.v1"},
    "api_version": {"const": "v1"},
    "publisher_epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "generation": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "run_epoch": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "config_revision": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "config_etag": {"type": "string", "minLength": 1, "maxLength": 256},
    "controller_epoch": {"type": ["string", "integer", "null"], "minimum": 0, "maximum": 18446744073709551615, "maxLength": 128},
    "job_id": {"type": ["string", "null"], "maxLength": 128},
    "correlation_id": {"type": ["string", "null"], "maxLength": 128},
    "semantic_class": {"type": ["string", "null"], "maxLength": 64},
    "payload": {"type": "object", "maxProperties": 1024}
  }
}
