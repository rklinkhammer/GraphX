{
  "schema": "graphx.fhss.dashboard.frontend_toolchain.v1",
  "node": "24.4.1",
  "npm": "11.5.2",
  "install_command": "npm ci --ignore-scripts --offline",
  "lockfile": "package-lock.json",
  "lockfile_version": 3,
  "build_time_only": true,
  "dashboard_disabled_build_dependency": false,
  "runtime_network_dependencies": false,
  "application_present": true,
  "application_phase": 1,
  "build_command": "npm run build",
  "output_directory": "../dist",
  "cmake_node_variable": "GRAPHX_DASHBOARD_NODE_EXECUTABLE",
  "cmake_npm_cli_variable": "GRAPHX_DASHBOARD_NPM_CLI",
  "developer_override": "GRAPHX_DASHBOARD_ALLOW_UNPINNED_TOOLCHAIN",
  "developer_override_release_evidence": false
}
