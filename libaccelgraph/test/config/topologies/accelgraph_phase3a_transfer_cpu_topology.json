      "source_node_id": "ingress",
      "source_port": 0,
      "target_node_id": "h2d",
      "target_port": 0
    },
    {
      "source_node_id": "h2d",
      "source_port": 0,
      "target_node_id": "d2h",
      "target_port": 0
    },
    {
      "source_node_id": "d2h",
      "source_port": 0,
      "target_node_id": "egress",
      "target_port": 0
