{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphx.invalid/schema/fhss-phase3-scenario-v2.json",
  "title": "GraphX FHSS Phase 3 strict independent scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenario_id", "seed", "active_frequency_indices", "messages", "channel"],
  "properties": {
    "schema": {"const": "graphx.fhss.phase3-scenario.v2"},
    "scenario_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "sample_format": {"enum": ["cf32_le", "cf64_le"]},
    "active_frequency_indices": {"const": [24, 28, 32, 36]},
    "allow_overlap": {"type": "boolean"},
    "tail_samples": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "messages": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["message_id", "transmitter_id", "transmit_start_sample", "pulses"],
        "properties": {
          "message_id": {"type": "integer", "minimum": 0},
          "transmitter_id": {"type": "integer", "minimum": 0},
          "transmit_start_sample": {"type": "integer", "minimum": 0},
          "initial_phase_rad": {"type": "number"},
          "randomize_initial_phase": {"type": "boolean"},
          "amplitude": {"type": "number", "exclusiveMinimum": 0},
          "pulses": {
            "type": "array", "minItems": 16, "maxItems": 256,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["frequency_index", "word", "role"],
              "properties": {
                "frequency_index": {"enum": [24, 28, 32, 36]},
                "word": {"type": "integer", "minimum": 0, "maximum": 4294967295},
                "role": {"enum": ["preamble", "body"]}
              }
            }
          }
        }
      }
    },
    "channel": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "timing": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "fractional_delay_samples": {"type": "number", "minimum": 0, "maximum": 10000},
            "sample_clock_offset_ppm": {"type": "number", "minimum": -10000, "maximum": 10000}
          }
        },
        "multipath": {
          "type": "object", "additionalProperties": false,
          "properties": {"taps": {"type": "array", "minItems": 1, "maxItems": 64,
            "items": {"type": "object", "additionalProperties": false,
              "required": ["delay_samples", "power_linear"],
              "properties": {
                "delay_samples": {"type": "number", "minimum": 0, "maximum": 100000},
                "power_linear": {"type": "number", "minimum": 0, "maximum": 1000000},
                "phase_rad": {"type": "number"}
              }}}}
        },
        "fading": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["none", "rayleigh", "rician", "sum_of_sinusoids_rayleigh"]},
            "k_factor_db": {"type": "number", "minimum": -100, "maximum": 100},
            "max_doppler_hz": {"type": "number", "minimum": 0, "maximum": 250000000},
            "oscillators": {"type": "integer", "minimum": 4, "maximum": 256}
          }
        },
        "carrier": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "cfo_hz": {"type": "number", "minimum": -250000000, "maximum": 250000000},
            "initial_phase_rad": {"type": "number"},
            "doppler_hz": {"type": "number", "minimum": -250000000, "maximum": 250000000},
            "phase_noise_step_std_rad": {"type": "number", "minimum": 0, "maximum": 10}
          }
        },
        "blockers": {"type": "array", "maxItems": 16,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["frequency_hz", "sir_db"],
            "properties": {
              "frequency_hz": {"type": "number", "minimum": -250000000, "maximum": 250000000},
              "sir_db": {"type": "number", "minimum": -200, "maximum": 200},
              "phase_rad": {"type": "number"}
            }}},
        "awgn": {"type": "object", "additionalProperties": false,
          "properties": {"eb_n0_db": {"type": "number", "minimum": -100, "maximum": 300}}},
        "hardware": {"type": "object", "additionalProperties": false,
          "properties": {
            "iq_gain_imbalance_db": {"type": "number", "minimum": -100, "maximum": 100},
            "iq_phase_imbalance_deg": {"type": "number", "minimum": -100, "maximum": 100},
            "dc_i": {"type": "number", "minimum": -100, "maximum": 100},
            "dc_q": {"type": "number", "minimum": -100, "maximum": 100},
            "agc_transient_samples": {"type": "integer", "minimum": 0, "maximum": 10000000},
            "clip_magnitude": {"type": "number", "minimum": 0, "maximum": 1000000},
            "quantization_bits": {"type": "integer", "minimum": 0, "maximum": 24}
          }}
      }
    }
  }
}
