    "model": {"type": "string"}, "firmware": {"type": "string"},
    "identifier_policy": {"enum": ["anonymized_stable", "approved_serial"]},
    "calibration_record_ids": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}
  }
}
