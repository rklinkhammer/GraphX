{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graphx.fhss.phase4-dataset-collection.v1",
  "title": "Governed external FHSS recorded-IQ collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "dataset_id", "description", "status", "external_storage", "equipment", "calibrations", "sessions", "captures", "partition_policy", "duplicate_policy", "rights"],
  "properties": {
    "schema": {"const": "graphx.fhss.phase4-dataset-collection.v1"},
    "version": {"const": 1},
    "dataset_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "description": {"type": "string"},
    "status": {"enum": ["development", "validation", "frozen_held_out"]},
    "external_storage": {"type": "object", "additionalProperties": false,
      "required": ["resolver_kind", "location_not_committed", "large_iq_in_git_prohibited"],
      "properties": {"resolver_kind": {"const": "explicit_root"}, "location_not_committed": {"const": true}, "large_iq_in_git_prohibited": {"const": true}}},
    "equipment": {"type": "array", "items": {"$ref": "fhss_phase4_equipment_inventory_schema_v1.json"}},
    "calibrations": {"type": "array", "items": {"$ref": "fhss_phase4_calibration_record_schema_v1.json"}},
    "sessions": {"type": "array", "items": {"$ref": "fhss_phase4_capture_session_schema_v1.json"}},
    "captures": {"type": "array", "items": {"$ref": "fhss_phase4_recorded_iq_schema_v1.json"}},
    "partition_policy": {"type": "object", "additionalProperties": false,
      "required": ["unit", "adjacent_slice_partitioning"],
      "properties": {"unit": {"const": "session"}, "adjacent_slice_partitioning": {"const": "prohibited"}}},
    "duplicate_policy": {"type": "object", "additionalProperties": false,
      "required": ["cross_partition_iq_reuse", "same_partition_iq_reuse"],
      "properties": {"cross_partition_iq_reuse": {"const": "prohibited"},
        "same_partition_iq_reuse": {"const": "requires_explicit_parent_relationship"}}},
    "rights": {"type": "object", "additionalProperties": false,
      "required": ["license", "privacy", "export_control", "retention", "redistribution"],
      "properties": {"license": {"type": "string", "minLength": 1}, "privacy": {"type": "string", "minLength": 1},
        "export_control": {"type": "string", "minLength": 1}, "retention": {"type": "string", "minLength": 1},
        "redistribution": {"type": "string", "minLength": 1}}}
  }
}
