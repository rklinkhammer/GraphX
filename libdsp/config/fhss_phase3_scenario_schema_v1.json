{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphx.invalid/schema/fhss-phase3-scenario-v1.json",
  "title": "GraphX FHSS Phase 3 independent waveform/channel scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenario_id", "seed", "active_frequency_indices", "messages"],
  "properties": {
    "schema": {"const": "graphx.fhss.phase3-scenario.v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "sample_format": {"enum": ["cf32_le", "cf64_le"]},
    "active_frequency_indices": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 62}
    },
    "allow_overlap": {"type": "boolean"},
    "tail_samples": {"type": "integer", "minimum": 0, "maximum": 4194304},
    "messages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["message_id", "transmit_start_sample", "pulses"],
        "properties": {
          "message_id": {"type": "integer", "minimum": 0},
          "transmitter_id": {"type": "integer", "minimum": 0},
          "transmit_start_sample": {"type": "integer", "minimum": 0},
          "initial_phase_rad": {"type": "number"},
          "randomize_initial_phase": {"type": "boolean"},
          "amplitude": {"type": "number", "exclusiveMinimum": 0},
          "pulses": {
            "type": "array", "minItems": 1, "maxItems": 256,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["frequency_index", "word", "role"],
              "properties": {
                "frequency_index": {"type": "integer", "minimum": 1, "maximum": 62},
                "word": {"type": "integer", "minimum": 0, "maximum": 4294967295},
                "role": {"enum": ["preamble", "body", "padding"]}
              }
            }
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "description": "Applied in the order frozen by the Phase 3 validation profile.",
      "properties": {
        "timing": {"type": "object"},
        "multipath": {"type": "object"},
        "fading": {"type": "object"},
        "carrier": {"type": "object"},
        "blockers": {"type": "array"},
        "awgn": {"type": "object"},
        "hardware": {"type": "object"}
      }
    }
  }
}
