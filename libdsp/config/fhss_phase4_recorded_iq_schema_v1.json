{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "graphx.fhss.phase4-recorded-iq.v1",
  "type": "object", "additionalProperties": false,
  "required": ["capture_id", "session_id", "capture_class", "partition", "relative_iq_path", "iq_sha256", "byte_length", "sample_format", "sample_rate_hz", "center_frequency_hz", "start_time_utc", "time_source_quality", "waveform_profile_id", "transmitter_event_log", "transmitter_event_log_sha256", "equipment_ids", "calibration_record_ids", "reference_plane", "wanted_power", "blocker_power", "cfo_hz", "sample_clock_offset_ppm", "agc_gain", "clipping_observed", "rf_path", "receiver_settings", "noise_floor", "channel_emulator", "ota", "environment", "operator_tool_versions", "rights", "parents", "derived_artifacts", "failure_or_exclusion", "scenario_tags", "provenance"],
  "properties": {
    "capture_id": {"type": "string"}, "session_id": {"type": "string"},
    "capture_class": {"enum": ["conducted", "channel_emulator", "ota", "negative_control", "synthetic_dry_run"]},
    "partition": {"enum": ["development", "validation", "held_out"]},
    "relative_iq_path": {"type": "string"}, "iq_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_length": {"type": "integer", "minimum": 1}, "sample_format": {"enum": ["cf32_le", "cf32_be", "cf64_le", "cf64_be"]},
    "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0}, "center_frequency_hz": {"type": "number", "minimum": 0},
    "start_time_utc": {"type": "string"}, "time_source_quality": {"$ref": "#/$defs/timeSource"}, "waveform_profile_id": {"type": "string"},
    "transmitter_event_log": {"type": ["string", "null"]}, "transmitter_event_log_sha256": {"type": ["string", "null"]},
    "equipment_ids": {"type": "array", "items": {"type": "string"}}, "calibration_record_ids": {"type": "array", "items": {"type": "string"}},
    "reference_plane": {"type": "string"}, "wanted_power": {"$ref": "#/$defs/power"}, "blocker_power": {"$ref": "#/$defs/power"},
    "cfo_hz": {"type": ["number", "null"]}, "sample_clock_offset_ppm": {"type": ["number", "null"]},
    "agc_gain": {"type": ["number", "null"]}, "clipping_observed": {"type": "boolean"},
    "rf_path": {"type": "array", "items": {"$ref": "#/$defs/rfComponent"}},
    "receiver_settings": {"$ref": "#/$defs/receiverSettings"}, "noise_floor": {"$ref": "#/$defs/noiseFloor"},
    "channel_emulator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/emulator"}]}, "ota": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ota"}]}, "environment": {"$ref": "#/$defs/environment"},
    "operator_tool_versions": {"$ref": "#/$defs/tools"}, "rights": {"$ref": "#/$defs/rights"}, "parents": {"type": "array", "items": {"type": "string"}},
    "derived_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}, "failure_or_exclusion": {"type": ["string", "null"]},
    "scenario_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["origin", "producer", "hardware_involved"], "properties": {"origin": {"enum": ["independently_recorded_physical", "synthetic_dry_run"]}, "producer": {"type": "string", "minLength": 1}, "hardware_involved": {"type": "boolean"}}},
    "sigmf_meta_path": {"type": "string"}, "sigmf_meta_sha256": {"type": "string"}, "notes": {"type": "string"}
  },
  "$defs": {
    "timeSource": {"type": "object", "additionalProperties": false, "required": ["kind", "uncertainty_seconds"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "uncertainty_seconds": {"type": ["number", "null"], "minimum": 0}}},
    "power": {"type": "object", "additionalProperties": false, "required": ["commanded_dbm", "measured_dbm", "uncertainty_db", "measurement_kind"],
      "properties": {"commanded_dbm": {"type": ["number", "null"]}, "measured_dbm": {"type": ["number", "null"]},
        "uncertainty_db": {"type": ["number", "null"], "minimum": 0}, "measurement_kind": {"enum": ["not_applicable", "commanded_only", "calibrated_inference", "measured"]}}},
    "rights": {"type": "object", "additionalProperties": false, "required": ["license", "privacy", "export_control", "retention", "redistribution"],
      "properties": {"license": {"type": "string", "minLength": 1}, "privacy": {"type": "string", "minLength": 1}, "export_control": {"type": "string", "minLength": 1}, "retention": {"type": "string", "minLength": 1}, "redistribution": {"type": "string", "minLength": 1}}},
    "tools": {"type": "object", "additionalProperties": false, "required": ["capture_tool", "capture_tool_version", "operator_id_policy"],
      "properties": {"capture_tool": {"type": "string"}, "capture_tool_version": {"type": "string"}, "operator_id_policy": {"type": "string"}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["temperature_c", "humidity_percent", "motion", "scenario_notes"],
      "properties": {"temperature_c": {"type": ["number", "null"]}, "humidity_percent": {"type": ["number", "null"]}, "motion": {"type": "string"}, "scenario_notes": {"type": "string"}}},
    "emulator": {"type": "object", "additionalProperties": false, "required": ["equipment_id", "model", "firmware", "configuration_relative_path", "configuration_sha256", "normalization", "reference_plane", "seed_repeat_behavior"],
      "properties": {"equipment_id": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "firmware": {"type": "string", "minLength": 1}, "configuration_relative_path": {"type": "string", "minLength": 1}, "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "normalization": {"type": "string", "minLength": 1}, "reference_plane": {"type": "string", "minLength": 1}, "seed_repeat_behavior": {"type": "string", "minLength": 1}}},
    "ota": {"type": "object", "additionalProperties": false, "required": ["authorization_id", "geometry", "antenna_configuration", "environment_description", "motion_profile", "facility_boundary"],
      "properties": {"authorization_id": {"type": "string"}, "geometry": {"type": "object"}, "antenna_configuration": {"type": "object"}, "environment_description": {"type": "string"}, "motion_profile": {"type": "string"}, "facility_boundary": {"type": "string"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "relative_path", "sha256", "provenance_relative_path", "provenance_sha256"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "provenance_relative_path": {"type": "string", "minLength": 1}, "provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    ,"rfComponent": {"type": "object", "additionalProperties": false, "required": ["equipment_id", "kind", "gain_loss_db", "uncertainty_db", "reference_plane"],
      "properties": {"equipment_id": {"type": "string"}, "kind": {"type": "string"}, "gain_loss_db": {"type": "number"}, "uncertainty_db": {"type": "number", "minimum": 0}, "reference_plane": {"type": "string"}}},
    "receiverSettings": {"type": "object", "additionalProperties": false, "required": ["gain_mode", "gain_db", "agc_enabled", "overload_observed"],
      "properties": {"gain_mode": {"type": "string"}, "gain_db": {"type": ["number", "null"]}, "agc_enabled": {"type": "boolean"}, "overload_observed": {"type": "boolean"}}},
    "noiseFloor": {"type": "object", "additionalProperties": false, "required": ["measured_dbm_hz", "uncertainty_db", "method"],
      "properties": {"measured_dbm_hz": {"type": ["number", "null"]}, "uncertainty_db": {"type": ["number", "null"], "minimum": 0}, "method": {"type": "string"}}}
  }
}
