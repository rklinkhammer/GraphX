{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GRAPHX_ENABLE_MODULE_PILOT": "OFF"
      }
    },
    {
      "name": "ninja-base-appleclang-macos",
      "hidden": true,
      "inherits": "ninja-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/graphx-appleclang-macos.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ninja-base-gcc-linux",
      "hidden": true,
      "inherits": "ninja-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/graphx-gcc-linux.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ninja-base-clang-linux",
      "hidden": true,
      "inherits": "ninja-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/graphx-clang-linux.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "description": "Default GraphX development preset (Ninja, modules pilot OFF)",
      "inherits": "ninja-base-appleclang-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-debug-linux-clang",
      "displayName": "Ninja Debug (Linux Clang)",
      "description": "Debug build profile for Linux hosts using Clang toolchain",
      "inherits": "ninja-base-clang-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GRAPHX_BUILD_PROFILE": "linux-ninja-host",
        "ENABLE_METAL_GRAPH_NODES": "OFF",
        "ENABLE_METAL_NATIVE_RUNTIME": "OFF",
        "GRAPHX_REQUIRE_METAL_NATIVE_RUNTIME": "OFF",
        "ENABLE_SYCL_GRAPH_NODES": "OFF"
      }
    },
    {
      "name": "ninja-debug-linux-host",
      "displayName": "Ninja Debug (Linux Host)",
      "description": "Debug build profile for Linux hosts without Metal-native requirements",
      "inherits": "ninja-base-gcc-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GRAPHX_BUILD_PROFILE": "linux-ninja-host",
        "ENABLE_METAL_GRAPH_NODES": "OFF",
        "ENABLE_METAL_NATIVE_RUNTIME": "OFF",
        "GRAPHX_REQUIRE_METAL_NATIVE_RUNTIME": "OFF",
        "ENABLE_SYCL_GRAPH_NODES": "OFF"
      }
    },
    {
      "name": "ninja-debug-jetson-cuda",
      "displayName": "Ninja Debug (Jetson CUDA)",
      "description": "Debug build profile for Jetson CUDA verification with CUDA graph nodes enabled",
      "binaryDir": "${sourceDir}/build-jetson-cuda",
      "inherits": "ninja-debug-linux-host",
      "cacheVariables": {
        "ENABLE_CUDA_GRAPH_NODES": "ON",
        "ACCELGRAPH_ENABLE_CUDA": "ON",
        "ENABLE_SYCL_GRAPH_NODES": "OFF",
        "ENABLE_METAL_GRAPH_NODES": "OFF",
        "ENABLE_METAL_NATIVE_RUNTIME": "OFF",
        "GRAPHX_REQUIRE_METAL_NATIVE_RUNTIME": "OFF"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "description": "Release build with Ninja (modules pilot OFF)",
      "inherits": "ninja-base-appleclang-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-debug-modules",
      "displayName": "Ninja Debug (Module Pilot)",
      "description": "Debug build with Ninja and module pilot enabled (toolchain dependent)",
      "inherits": "ninja-base-appleclang-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GRAPHX_ENABLE_MODULE_PILOT": "ON"
      }
    },
    {
      "name": "ninja-debug-metal-native",
      "displayName": "Ninja Debug (Metal Native)",
      "description": "Debug build with native Metal runtime requested via metal-cpp",
      "inherits": "ninja-base-appleclang-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SYCL_GRAPH_NODES": "OFF",
        "ENABLE_METAL_GRAPH_NODES": "ON",
        "ENABLE_METAL_NATIVE_RUNTIME": "ON",
        "GRAPHX_METAL_CPP_INCLUDE_DIR": "/opt/homebrew/include"
      }
    },
    {
      "name": "ninja-debug-metal-native-strict",
      "displayName": "Ninja Debug (Metal Native, Strict)",
      "description": "Debug build with strict native Metal runtime requirement",
      "inherits": "ninja-debug-metal-native",
      "cacheVariables": {
        "GRAPHX_REQUIRE_METAL_NATIVE_RUNTIME": "ON"
      }
    },
    {
      "name": "ninja-release-metal-native",
      "displayName": "Ninja Release (Metal Native)",
      "description": "Release build with native Metal runtime requested via metal-cpp",
      "inherits": "ninja-base-appleclang-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_SYCL_GRAPH_NODES": "OFF",
        "ENABLE_METAL_GRAPH_NODES": "ON",
        "ENABLE_METAL_NATIVE_RUNTIME": "ON",
        "GRAPHX_METAL_CPP_INCLUDE_DIR": "/opt/homebrew/include"
      }
    },
    {
      "name": "ninja-ci-linux",
      "displayName": "Ninja CI (Linux)",
      "description": "CI configure preset for Linux hosts",
      "inherits": "ninja-debug-linux-host",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "ninja-ci-macos",
      "displayName": "Ninja CI (macOS)",
      "description": "CI configure preset for macOS hosts",
      "inherits": "ninja-base-appleclang-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SYCL_GRAPH_NODES": "OFF",
        "ENABLE_METAL_GRAPH_NODES": "ON",
        "ENABLE_METAL_NATIVE_RUNTIME": "OFF",
        "GRAPHX_REQUIRE_METAL_NATIVE_RUNTIME": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "displayName": "Build Debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "build-debug-linux-host",
      "displayName": "Build Debug (Linux Host)",
      "configurePreset": "ninja-debug-linux-host"
    },
    {
      "name": "build-jetson-cuda",
      "displayName": "Build Debug (Jetson CUDA)",
      "configurePreset": "ninja-debug-jetson-cuda"
    },
    {
      "name": "build-release",
      "displayName": "Build Release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "build-libgraph-unit",
      "displayName": "Build test_libgraph_unit",
      "configurePreset": "ninja-debug",
      "targets": [
        "test_libgraph_unit"
      ]
    },
    {
      "name": "build-libgraph-unit-metal-native",
      "displayName": "Build test_libgraph_unit (Metal Native)",
      "configurePreset": "ninja-debug-metal-native",
      "targets": [
        "test_libgraph_unit"
      ]
    },
    {
      "name": "build-libgraph-unit-metal-native-strict",
      "displayName": "Build test_libgraph_unit (Metal Native, Strict)",
      "configurePreset": "ninja-debug-metal-native-strict",
      "targets": [
        "test_libgraph_unit"
      ]
    },
    {
      "name": "build-libdsp-unit",
      "displayName": "Build test_libdsp_unit",
      "configurePreset": "ninja-debug",
      "targets": [
        "test_libdsp_unit"
      ]
    },
    {
      "name": "build-libdsp-unit-metal-native",
      "displayName": "Build test_libdsp_unit (Metal Native)",
      "configurePreset": "ninja-debug-metal-native",
      "targets": [
        "test_libdsp_unit"
      ]
    },
    {
      "name": "build-libdsp-unit-metal-native-strict",
      "displayName": "Build test_libdsp_unit (Metal Native, Strict)",
      "configurePreset": "ninja-debug-metal-native-strict",
      "targets": [
        "test_libdsp_unit"
      ]
    },
    {
      "name": "build-debug-metal-native",
      "displayName": "Build Debug (Metal Native)",
      "configurePreset": "ninja-debug-metal-native"
    },
    {
      "name": "build-debug-metal-native-strict",
      "displayName": "Build Debug (Metal Native, Strict)",
      "configurePreset": "ninja-debug-metal-native-strict"
    },
    {
      "name": "build-sar-tests",
      "displayName": "Build SAR Test Lanes",
      "configurePreset": "ninja-debug",
      "targets": [
        "test_sar_crsd_io",
        "test_sar_nodes",
        "test_sar_runtime_integration",
        "test_sar_local_only"
      ]
    },
    {
      "name": "build-sar-tests-metal-native",
      "displayName": "Build SAR Test Lanes (Metal Native)",
      "configurePreset": "ninja-debug-metal-native",
      "targets": [
        "test_sar_crsd_io",
        "test_sar_nodes",
        "test_sar_runtime_integration",
        "test_sar_local_only"
      ]
    },
    {
      "name": "build-sar-tests-metal-native-strict",
      "displayName": "Build SAR Test Lanes (Metal Native, Strict)",
      "configurePreset": "ninja-debug-metal-native-strict",
      "targets": [
        "test_sar_crsd_io",
        "test_sar_nodes",
        "test_sar_runtime_integration",
        "test_sar_local_only"
      ]
    },
    {
      "name": "build-release-metal-native",
      "displayName": "Build Release (Metal Native)",
      "configurePreset": "ninja-release-metal-native"
    },
    {
      "name": "build-ci-linux",
      "displayName": "Build CI (Linux)",
      "configurePreset": "ninja-ci-linux"
    },
    {
      "name": "build-ci-macos",
      "displayName": "Build CI (macOS)",
      "configurePreset": "ninja-ci-macos"
    }
  ],
  "testPresets": [
    {
      "name": "test-libgraph-unit",
      "displayName": "Run libgraph unit tests",
      "configurePreset": "ninja-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libgraph_unit"
        }
      }
    },
    {
      "name": "test-libgraph-unit-linux-host",
      "displayName": "Run libgraph unit tests (Linux Host Debug)",
      "configurePreset": "ninja-debug-linux-host",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libgraph_unit"
        }
      }
    },
    {
      "name": "test-libgraph-unit-metal-native",
      "displayName": "Run libgraph unit tests (Metal Native Debug)",
      "configurePreset": "ninja-debug-metal-native",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libgraph_unit"
        }
      }
    },
    {
      "name": "test-libgraph-unit-metal-native-strict",
      "displayName": "Run libgraph unit tests (Metal Native, Strict)",
      "configurePreset": "ninja-debug-metal-native-strict",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libgraph_unit"
        }
      }
    },
    {
      "name": "test-libdsp-unit",
      "displayName": "Run libdsp unit tests",
      "configurePreset": "ninja-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libdsp_unit"
        }
      }
    },
    {
      "name": "test-libdsp-unit-linux-host",
      "displayName": "Run libdsp unit tests (Linux Host Debug)",
      "configurePreset": "ninja-debug-linux-host",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libdsp_unit"
        }
      }
    },
    {
      "name": "test-libdsp-unit-metal-native",
      "displayName": "Run libdsp unit tests (Metal Native Debug)",
      "configurePreset": "ninja-debug-metal-native",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libdsp_unit"
        }
      }
    },
    {
      "name": "test-libdsp-unit-metal-native-strict",
      "displayName": "Run libdsp unit tests (Metal Native, Strict)",
      "configurePreset": "ninja-debug-metal-native-strict",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libdsp_unit"
        }
      }
    },
    {
      "name": "test-libgpu-metal-runtime",
      "displayName": "Run native Metal runtime tests",
      "configurePreset": "ninja-debug-metal-native",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libgpu_metal_runtime",
          "label": "host-macos"
        }
      }
    },
    {
      "name": "test-libgpu-metal-runtime-strict",
      "displayName": "Run native Metal runtime tests (strict)",
      "configurePreset": "ninja-debug-metal-native-strict",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "libgpu_metal_runtime",
          "label": "host-macos"
        }
      }
    },
    {
      "name": "test-sar-ci",
      "displayName": "Run CI-safe SAR test lanes",
      "configurePreset": "ninja-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^sar_(crsd_io|nodes|runtime_integration)$"
        }
      }
    },
    {
      "name": "test-sar-ci-metal-native",
      "displayName": "Run CI-safe SAR test lanes (Metal Native)",
      "configurePreset": "ninja-debug-metal-native",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^sar_(crsd_io|nodes|runtime_integration)$"
        }
      }
    },
    {
      "name": "test-sar-ci-metal-native-strict",
      "displayName": "Run CI-safe SAR test lanes (Metal Native, Strict)",
      "configurePreset": "ninja-debug-metal-native-strict",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^sar_(crsd_io|nodes|runtime_integration)$"
        }
      }
    },
    {
      "name": "test-sar-sarpy-lane",
      "displayName": "Run SarPy-labeled SAR tests",
      "configurePreset": "ninja-debug-metal-native",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "sarpy"
        }
      }
    },
    {
      "name": "test-ci-linux",
      "displayName": "Run CI test lanes (Linux)",
      "configurePreset": "ninja-ci-linux",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^(libgraph_unit|libdsp_unit|sar_(crsd_io|nodes|runtime_integration))$",
          "label": "host-any|host-linux"
        }
      }
    },
    {
      "name": "test-ci-macos",
      "displayName": "Run CI test lanes (macOS)",
      "configurePreset": "ninja-ci-macos",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^(libgraph_unit|libdsp_unit|sar_(crsd_io|nodes|runtime_integration))$",
          "label": "host-any|host-macos"
        }
      }
    }
  ]
}
